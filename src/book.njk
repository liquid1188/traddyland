---
layout: base.njk
title: The book
permalink: /book/
description: "Traddyland: Memoir of a Radical Traditional Catholic. Synopsis, praise, a free excerpt, and where to buy."
---
<div class="wrap page-head">
  <h1>Traddyland</h1>
  <p class="lede">Memoir of a Radical Traditional Catholic. He was thirteen when they put him on the bus to Kansas.</p>
</div>
<section class="band" style="padding-top:1.5rem">
  <div class="wrap two-col top">
    <div class="prose">
      {{ book.body | md | dropcap | safe }}
      <blockquote>{{ book.quote }}<br><span style="font-size:.9rem;font-style:normal;color:var(--ink-2)">{{ book.quoteCite }}</span></blockquote>
    </div>
    <div>
      <img src="/images/cover.jpg" alt="Traddyland cover" width="982" height="1476" style="width:100%;max-width:340px;box-shadow:0 24px 50px -20px rgba(0,0,0,.5)">
      <div class="facts" style="margin-top:1.5rem;max-width:340px">
        <dl>
          {%- for f in book.facts %}<dt>{{ f.label }}</dt><dd>{{ f.value }}</dd>{% endfor %}
        </dl>
        <a class="btn" href="{{ site.amazon }}" style="display:block;text-align:center;margin-top:1.2rem">Buy on Amazon</a>
      </div>
    </div>
  </div>
</section>


<section class="band white">
  <div class="wrap">
    <div class="band-head"><h2>Praise</h2><a class="textlink" href="/press/">Full press coverage →</a></div>
    <div class="praise">
    {%- for q in praise %}<blockquote{% if q.featured %} class="wide"{% endif %}>{{ q.quote }}<cite>{{ q.who }}</cite></blockquote>{% endfor %}
    </div>
  </div>
</section>

<section class="band" id="buy">
  <div class="wrap">
    <div class="band-head"><h2>Where to buy</h2></div>
    <div class="buy">
    {%- for b in buy %}<a href="{{ b.url }}" class="buy-{{ b.name | slugify }}">{% if b.logo %}<img class="buy-logo" src="{{ b.logo }}" alt="{{ b.name }}">{% if b.name == "Apple Books" %}<strong class="buy-wm">Apple Books</strong>{% endif %}{% else %}<strong class="buy-wm">{{ b.name }}</strong>{% endif %}<span>{{ b.note }}</span></a>{% endfor %}
    </div>
    <p style="margin-top:1.5rem;color:var(--ink-2)">If the book moves you, the single most helpful thing you can do is leave an honest review on Amazon when you finish. That is how memoirs find their readers.</p>
  </div>
</section>

{% include "signup.njk" %}
