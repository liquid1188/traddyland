<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}Traddyland by Lou Massett</title>
  <meta name="description" content="{{ description or site.tagline }}">
  {% if site.setupMode %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v={{ buildId }}">
  <meta property="og:title" content="{{ title or 'Traddyland' }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:image" content="{{ site.url }}/images/cover.jpg">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Book","name":"Traddyland: Memoir of a Radical Traditional Catholic","author":{"@type":"Person","name":"Louis Massett"},"isbn":"9798996501410","bookFormat":"Paperback","url":"{{ site.url }}","offers":{"@type":"Offer","url":"{{ site.amazon }}"}}</script>
</head>
<body{% if page.url == "/" %} class="home"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href="/">Traddyland</a>
    <input type="checkbox" id="menu" class="menu-toggle" aria-label="Open menu">
    <label for="menu" class="menu-btn"><span></span><span></span></label>
    <nav class="nav" aria-label="Main">
      <a href="/book/"{% if page.url == '/book/' %} aria-current="page"{% endif %}>The book</a>
      <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>Lou Massett</a>
      <a href="/press/"{% if page.url == '/press/' %} aria-current="page"{% endif %}>Press</a>
      <a href="/podcast/"{% if page.url == '/podcast/' %} aria-current="page"{% endif %}>Podcast</a>
      <a href="/news/"{% if '/news' in page.url %} aria-current="page"{% endif %}>Background</a>
      <a href="/contact/"{% if page.url == '/contact/' %} aria-current="page"{% endif %}>Contact</a>
      <a class="btn small ghost" href="/support/">Support</a>
      <a class="btn small" href="{{ site.amazon }}">Buy the book</a>
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-foot v2">
  <div class="wrap foot-top">
    <div class="fbrand">
      <p class="foot-brand">Traddyland</p>
      
      <p class="foot-tag">Memoir of a Radical Traditional Catholic, by Louis Massett. In English and Spanish, paperback and Kindle.</p>
      <div class="foot-ctas"><a class="btn" href="{{ site.amazon }}">Buy on Amazon</a><a class="btn ghost" href="/support/">Support the work</a></div>
    </div>
    <div class="fcol"><h3>Read</h3><a href="/book/">The book</a><a href="/book/#excerpt">Read Act I free</a><a href="/press/">Press and reviews</a><a href="/news/">Background reading</a><a href="/podcast/">Podcast</a></div><div class="fcol"><h3>Lou</h3><a href="/about/">Biography</a><a href="/about/#speaking">Interviews and speaking</a><a href="/contact/">Contact</a></div>
    <div class="fcol fcontact">
      <h3>Connect</h3>
      <a class="crow" href="mailto:{{ site.email }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M3 6h18v12H3z"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="m3 7 9 6 9-6"/></svg><span>{{ site.email }}</span></a>
      <div class="socials"><a class="soc" href="{{ site.social.instagram }}" aria-label="Instagram" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg></a><a class="soc" href="{{ site.social.facebook }}" aria-label="Facebook" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7h2.4l.4-3h-2.8V9.2c0-.9.3-1.5 1.5-1.5h1.5V5.1c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H8v3h2.6v7z"/></svg></a><a class="soc" href="{{ site.social.x }}" aria-label="X" title="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 3h4.5l4 5.6L17.5 3H20l-6.2 7.3L20.5 21H16l-4.3-6L6.5 21H4l6.6-7.7z"/></svg></a><a class="soc" href="{{ site.social.youtube }}" aria-label="YouTube" title="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M3 8.5C3 6.6 4.5 5 6.4 5h11.2C19.5 5 21 6.6 21 8.5v7c0 1.9-1.5 3.5-3.4 3.5H6.4C4.5 19 3 17.4 3 15.5z"/><path fill="currentColor" d="m10 9 5 3-5 3z"/></svg></a><a class="soc" href="{{ site.social.tiktok }}" aria-label="TikTok" title="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 3h3c.2 2 1.5 3.4 3.5 3.6v3c-1.3 0-2.5-.4-3.5-1.1V15a5.5 5.5 0 1 1-5.5-5.5h.5v3a2.5 2.5 0 1 0 2 2.4z"/></svg></a><a class="soc" href="{{ site.social.linkedin }}" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 9h3.5v11H4zM5.8 3.5a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zM9.5 9h3.3v1.5c.5-.9 1.7-1.8 3.5-1.8 3.4 0 4 2.2 4 5.1V20h-3.5v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V20H9.5z"/></svg></a></div>
    </div>
  </div>
  
  <div class="wrap foot-bottom">
    <span class="copy">&copy; {{ today | year }} Louis Massett. All rights reserved.</span>
    <span class="util"><a href="/privacy/">Privacy</a><a href="/admin/">Sign in</a><a href="https://lickitysplitweb.com">Site by Lickity Split Web Design</a><a class="totop" href="#main" aria-label="Back to top"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="m6 14 6-6 6 6"/></svg></a></span>
  </div>
</footer>
</body>
</html>
