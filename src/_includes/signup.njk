<section class="band dusk on-dark" id="excerpt">
  <div class="wrap two-col signup">
    <div>
      <h2>Read Act I for free.</h2>
      <p>Leave your email and Lou will send you the first act of <em>Traddyland</em> as a PDF, along with a short letter every few weeks about the book, the podcast, and the parts of this story still unfolding.</p>
    </div>
    <div>
      {%- if site.buttondown %}
      <form action="https://buttondown.com/api/emails/embed-subscribe/{{ site.buttondown }}" method="POST" target="_blank">
        <input type="hidden" name="tag" value="act-one">
        <input type="email" name="email" placeholder="Email address" required aria-label="Email address">
      {%- else %}
      <form action="https://formsubmit.co/{{ site.email }}" method="POST">
        <input type="hidden" name="_subject" value="Act I request from traddyland.com">
        <input type="hidden" name="_next" value="{{ site.url }}/act-one/">
        <input type="hidden" name="_autoresponse" value="Thanks for your interest in Traddyland. Here is Act I as a PDF: {{ site.url }}/files/traddyland-act-one.pdf  If it grabs you, the full book is on Amazon in paperback and Kindle: {{ site.amazon }}  And you are welcome to join the conversation with other readers on the Traddyland forum: {{ site.url }}/forum/  Every few weeks I will send a short letter about the book, the podcast, and the parts of this story still unfolding. Reply anytime. Lou Massett">
        <input type="email" name="email" placeholder="Email address" required aria-label="Email address">
      {%- endif %}
        <button class="btn" type="submit">Send me Act I</button>
      </form>
      <p class="fine">No spam. Unsubscribe any time.</p>
    </div>
  </div>
</section>
