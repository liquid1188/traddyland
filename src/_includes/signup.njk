<section class="band dusk on-dark" id="excerpt">
  <div class="wrap two-col signup">
    <div>
      <h2>Read Act I for free.</h2>
      <p>Leave your email and Lou will send you the first act of <em>Traddyland</em> as a PDF, along with a short letter every few weeks about the book, the podcast, and the parts of this story still unfolding.</p>
    </div>
    <div>
      <form action="https://formsubmit.co/{{ site.email }}" method="POST">
        <input type="hidden" name="_subject" value="Act I request from traddyland.com">
        <input type="hidden" name="_next" value="{{ site.url }}/thanks/">
        <input type="email" name="email" placeholder="Email address" required aria-label="Email address">
        <button class="btn" type="submit">Send me Act I</button>
      </form>
      <p class="fine">No spam. Unsubscribe any time.</p>
    </div>
  </div>
</section>
