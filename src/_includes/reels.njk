{#- Lou's short vertical videos (YouTube Shorts and Facebook reels).
    mode "row": small previews on one line that scrolls sideways.
    mode "carousel": a centred strip of same-size previews; the middle one
    is the one to watch, arrows at the sides and below move it. Nothing loads from YouTube or Facebook until one is pressed. -#}
{%- if reels and reels.length %}
<div class="reels reels-{{ mode }}"{% if mode == "carousel" %} data-carousel{% endif %}>
  {%- if mode == "row" %}<button type="button" class="reels-scroll reels-back" aria-label="Scroll back">&#8249;</button>{% else %}<button type="button" class="reels-side reels-prev" aria-label="Previous video">&#8249;</button>
  <div class="reels-viewport">{% endif %}
  <ul class="reels-track">
  {%- for r in reels %}
    {%- set link = ("https://www.youtube.com/shorts/" + r.id) if r.platform == "youtube" else ("https://www.facebook.com/reel/" + r.id) %}
    {%- set thumb = r.thumb or (("https://i.ytimg.com/vi/" + r.id + "/hqdefault.jpg") if r.platform == "youtube" else ("/images/reels/fb-" + r.id + ".jpg")) %}
    <li class="reel">
      <button type="button" class="reel-play" data-platform="{{ r.platform }}" data-id="{{ r.id }}" data-title="{{ r.title or 'Lou Massett' }}" aria-label="Play{% if r.title %}: {{ r.title }}{% else %} this video{% endif %}">
        <img src="{{ thumb }}" alt="" loading="lazy">
        <span class="reel-icon" aria-hidden="true"></span>
        <span class="reel-src">{{ "YouTube" if r.platform == "youtube" else "Facebook" }}</span>
      </button>
      {%- if r.title %}<p class="reel-title"><a href="{{ link }}">{{ r.title }}</a></p>{% endif %}
    </li>
  {%- endfor %}
  </ul>
  {%- if mode == "row" %}<button type="button" class="reels-scroll reels-fwd" aria-label="Scroll forward">&#8250;</button>{% else %}</div>
  <button type="button" class="reels-side reels-next" aria-label="Next video">&#8250;</button>{% endif %}
  {%- if mode == "carousel" and reels.length > 1 %}
  <div class="reels-nav">
    <button type="button" class="reels-prev" aria-label="Previous video">&#8249;</button>
    <span class="reels-count" aria-live="polite">1 / {{ reels.length }}</span>
    <button type="button" class="reels-next" aria-label="Next video">&#8250;</button>
  </div>
  {%- endif %}
</div>
<script>
(function () {
  var box = document.currentScript.previousElementSibling;
  if (!box || !box.classList.contains("reels")) return;
  var items = [].slice.call(box.querySelectorAll(".reel"));
  var timer = null, i = 0;
  function stop() { if (timer) { clearInterval(timer); timer = null; } }
  function src(b) {
    if (b.dataset.platform === "facebook") {
      return "https://www.facebook.com/plugins/video.php?href=" + encodeURIComponent("https://www.facebook.com/reel/" + b.dataset.id) + "&show_text=false&autoplay=true&width=360";
    }
    return "https://www.youtube-nocookie.com/embed/" + b.dataset.id + "?autoplay=1&playsinline=1&rel=0";
  }
  function play(b) {
    stop();
    var f = document.createElement("iframe");
    f.src = src(b);
    f.title = b.dataset.title;
    f.allow = "autoplay; encrypted-media; picture-in-picture; web-share";
    f.allowFullscreen = true;
    f.className = "reel-frame";
    f._preview = b;
    b.replaceWith(f);
  }
  box.addEventListener("click", function (e) {
    var b = e.target.closest(".reel-play");
    if (b) play(b);
  });
  var track = box.querySelector(".reels-track");
  [["reels-back", -1], ["reels-fwd", 1]].forEach(function (p) {
    var btn = box.querySelector("." + p[0]);
    if (btn) btn.addEventListener("click", function () { track.scrollBy({ left: p[1] * track.clientWidth * 0.8, behavior: "smooth" }); });
  });
  if (!box.hasAttribute("data-carousel")) return;
  var view = box.querySelector(".reels-viewport");
  var count = box.querySelector(".reels-count");
  function place() {
    var w = items[0].offsetWidth, gap = parseFloat(getComputedStyle(track).columnGap) || 0;
    var x = view.clientWidth / 2 - (i * (w + gap) + w / 2);
    track.style.transform = "translateX(" + x + "px)";
  }
  function show(n) {
    // A video that is playing goes back to its preview when it leaves the middle.
    var fr = items[i].querySelector(".reel-frame");
    if (fr && fr._preview) fr.replaceWith(fr._preview);
    i = (n + items.length) % items.length;
    items.forEach(function (el, k) {
      el.classList.toggle("is-current", k === i);
      var b = el.querySelector(".reel-play");
      if (b) b.tabIndex = k === i ? 0 : -1;
    });
    if (count) count.textContent = (i + 1) + " / " + items.length;
    place();
  }
  // Pressing a side preview brings it to the middle instead of playing it.
  box.addEventListener("click", function (e) {
    var li = e.target.closest(".reel");
    if (li && !li.classList.contains("is-current")) { e.stopImmediatePropagation(); e.preventDefault(); show(items.indexOf(li)); }
  }, true);
  [].forEach.call(box.querySelectorAll(".reels-prev"), function (b) { b.addEventListener("click", function () { show(i - 1); }); });
  [].forEach.call(box.querySelectorAll(".reels-next"), function (b) { b.addEventListener("click", function () { show(i + 1); }); });
  box.addEventListener("keydown", function (e) {
    if (e.key === "ArrowLeft") show(i - 1);
    if (e.key === "ArrowRight") show(i + 1);
  });
  window.addEventListener("resize", place);
  show(0);
})();
</script>
{%- endif %}
