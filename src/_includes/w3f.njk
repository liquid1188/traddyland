<script>window.W3F_KEY="{{ site.web3formsKey }}";window.w3fBody=function(o){var out={};for(var k in o){var v=o[k];if(k==='_subject')out.subject=v;else if(k==='_replyto')out.replyto=v;else if(k==='_honey'||k==='_gotcha'){if(v)out.botcheck=v;}else if(k.charAt(0)!=='_')out[k]=v;}if(window.W3F_KEY)out.access_key=window.W3F_KEY;return JSON.stringify(out);};</script>

<script>
/* Send Web3Forms forms in the background and thank the visitor on the page.
   "redirect" stays out of the background request so Web3Forms answers in JSON;
   if that request fails, the form posts the ordinary way instead. */
(function(){
  document.querySelectorAll('form[action="https://api.web3forms.com/submit"]').forEach(function(form){
    form.addEventListener('submit',function(ev){
      if(form.dataset.native) return;
      ev.preventDefault();
      var btn=form.querySelector('button[type=submit]'),label=btn?btn.textContent:'';
      if(btn){btn.disabled=true;btn.textContent='Sending...';}
      var data={};new FormData(form).forEach(function(v,k){if(k!=='redirect'&&k!=='_next')data[k]=v;});
      fetch(form.action,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(data)})
        .then(function(r){return r.json();})
        .then(function(res){
          if(!(res&&(res.success===true||res.success==='true')))throw 0;
          var n=document.createElement('p');n.className='form-thanks';n.setAttribute('role','status');
          n.style.cssText='margin:0;padding:1rem 1.25rem;border:1px solid currentColor;border-radius:6px;font-weight:600;line-height:1.5;';
          n.textContent=form.dataset.thanks||'Thank you. Your message has been sent.';
          form.parentNode.replaceChild(n,form);n.scrollIntoView({block:'center',behavior:'smooth'});
        })
        .catch(function(){if(btn){btn.disabled=false;btn.textContent=label;}form.dataset.native='1';form.submit();});
    });
  });
})();
</script>