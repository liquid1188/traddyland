---
layout: base.njk
title: Videos
permalink: /videos/
description: "Watch Lou Massett's video interviews about Traddyland, with Larry Chapp, Christine Niles, Catholic Unscripted, and others, plus his short clips."
---
<div class="wrap page-head">
  <h1>Videos</h1>
  <p class="lede">Lou's conversations about Traddyland, on camera. For interview requests, write to <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
</div>
{%- for v in videos %}{% if v.spotlight %}
<section class="band white spotlight videos-feature">
  <div class="wrap spotlight-grid">
    <div class="vframe"><iframe src="{{ v.embed }}" title="{{ v.title }}" loading="lazy" allowfullscreen allow="accelerometer; encrypted-media; picture-in-picture"></iframe></div>
    <div>
      <p class="kicker">Featured · {{ v.show }}</p>
      <h2 style="font-size:clamp(1.4rem,2.4vw,1.9rem)">{{ v.title }}</h2>
      <p class="meta">{{ v.date }}</p>
      {% if v.note %}<p class="caption">{{ v.note }}</p>{% endif %}
      {% if v.segmentUrl %}<a class="textlink" href="{{ v.segmentUrl }}">{{ v.segmentLabel or "Jump to Lou's segment" }} →</a>{% else %}<a class="textlink" href="{{ v.url }}">Watch on YouTube →</a>{% endif %}
    </div>
  </div>
</section>
{%- endif %}{% endfor %}
{%- if reels and reels.length %}
<section class="band" style="padding-bottom:1rem">
  <div class="wrap">
    <div class="band-head"><h2>Short clips</h2><span class="meta" style="color:var(--ink-2);font-size:.95rem">Under a minute each, from YouTube and Facebook</span></div>
    {%- set mode = "row" %}{% include "reels.njk" %}
  </div>
</section>
{%- endif %}
<section class="band" style="padding-top:1.5rem">
  <div class="wrap">
  <div class="band-head"><h2>Interviews</h2></div>
  <div class="video-list">
  {%- for v in videos %}{% if not v.spotlight %}
    <article class="video-item">
      <div class="vframe"><iframe src="{{ v.embed }}" title="{{ v.title }}" loading="lazy" allowfullscreen allow="accelerometer; encrypted-media; picture-in-picture"></iframe></div>
      <h3><a href="{{ v.url }}">{{ v.title }}</a></h3>
      <p class="meta">{{ v.show }} · {{ v.date }}</p>
      {%- if v.note %}<p>{{ v.note }}</p>{% endif %}
      {%- if v.clips %}
      <p class="clips-label">Shorter clips from this episode:</p>
      <ul class="video-clips">
        {%- for c in v.clips %}<li><a href="{{ c.url }}">{{ c.title }}</a></li>{% endfor %}
      </ul>
      {%- endif %}
    </article>
  {%- endif %}{% endfor %}
  </div>
  </div>
</section>
